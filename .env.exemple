# Copiez ce fichier en « .env » et adaptez-le.
PORT=3000
# Soit une URL complète (Render, Neon, Supabase, Railway…) :
# DATABASE_URL=postgres://utilisateur:motdepasse@serveur:5432/kfnpharma?sslmode=require
# Soit les paramètres séparés :
PGHOST=localhost
PGPORT=5432
PGDATABASE=kfnpharma
PGUSER=kfn
PGPASSWORD=kfn
# PGSSL=true            # base distante qui exige SSL
SESSION_SECRET=remplacez-par-une-longue-phrase-secrete
# SECURE_COOKIES=true   # si le site est en https
